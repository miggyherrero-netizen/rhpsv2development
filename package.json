{
  "name": "herrero-pianos",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "npm run lint && npm run typecheck && node tests/run-tests.mjs",
    "test:domain": "node tests/run-tests.mjs",
    "test:service": "tsx tests/service-money.ts",
    "test:service-mock": "tsx tests/service-mock.ts",
    "test:documents": "tsx tests/service-documents.ts",
    "test:integration": "node tests/task-flow.cjs",
    "test:all": "npm test && npm run test:integration && npm run build",
    "dev:up": "docker compose up -d --build",
    "dev:down": "docker compose down",
    "dev:ps": "docker compose ps",
    "test:gos": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "gos:create-owner": "tsx scripts/gos-create-owner.ts"
  },
  "dependencies": {
    "dotenv": "17.3.1",
    "drizzle-kit": "0.31.10",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.47.0",
    "next": "16.2.6",
    "pg": "8.20.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tsx": "^4.23.15",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "22.19.15",
    "@types/pg": "8.18.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "postcss": "8.5.8",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
